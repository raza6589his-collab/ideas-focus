@echo off
chcp 65001 >nul
title همگام‌سازی دارایی‌های وب برای اندروید
color 0a

echo ============================================================
echo   📱 در حال آماده‌سازی و همگام‌سازی دارایی‌های اندروید...
echo ============================================================
echo.

cd /d "%~dp0.."
python packaging\sync_android_assets.py

if %errorlevel% neq 0 (
    echo [خطا] همگام‌سازی با شکست مواجه شد.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   ✓ دارایی‌های آفلاین اندروید با موفقیت به‌روز شدند!
echo ============================================================
echo.
pause
